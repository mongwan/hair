# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성에서 복사
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true면 로컬 Firestore 에뮬레이터(localhost:8080)에 연결
VITE_USE_EMULATOR=false

# 배포 주소 (끝에 / 없이). 카카오톡/트위터 미리보기 이미지(og:image)는 절대 주소가 필요
VITE_SITE_URL=https://YOUR_PROJECT_ID.web.app
